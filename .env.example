# YouTube Data API v3 Key (used by /lib/sources/youtube.ts)
# Get one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Meta / Instagram Graph API App Access Token (used by /lib/sources/instagram.ts)
# Format: {your-app-id}|{your-app-secret}
# Get one at https://developers.facebook.com/
META_APP_TOKEN=

# Cache TTL in seconds (default: 600 = 10 minutes)
CACHE_TTL_SECONDS=600
